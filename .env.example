# Copy the webapp block into webapp/.env
# Copy the AI service block into ai-service/.env
# Never commit real keys. Never put Exa / OpenRouter keys in webapp/.env.

# --- webapp/.env ---
VITE_APP_NAME=HealNexus
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AI_API_BASE_URL=http://127.0.0.1:8001

# --- ai-service/.env ---
# EXA_API_KEY=
# OPENROUTER_API_KEY=
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
